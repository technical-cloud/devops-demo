trigger: none

# -------------------------------
# Hardcoded Variables
# -------------------------------
variables:
  org_url: "https://dev.azure.com/vadapavsamosa/user19"
  agent_pool: "vadapav"
  agent_name: "vipin-agent-machine"
  ado_pat: "2hsB8h0MY96XhI4e9STeY2gwkVGGy8UDtoEDRIQzD5QzpmxABOxfJQQJ99BJACAAAAAp9R4wAAASAZDOmciV"

# -------------------------------
# Global Pool
# -------------------------------
pool:
  name: 'vadapav'

# -------------------------------
# Stages
# -------------------------------
stages:

# -------------------------------
# Stage 1 – Create VM
# -------------------------------
- stage: VM_Creation_using_existing_Self_Hosted_Agent
  displayName: 'Create Self-Hosted VM using Terraform'
  jobs:
  - job: checkout_code_vm_setup
    displayName: 'Checkout and Run Terraform for VM Setup'
    pool:
      name: 'vadapav'
    steps:
    - checkout: self
      path: vm-setup-azure-devops-tools

    - script: |
        echo "Installing Terraform..."
        sudo apt-get update -y
        sudo apt-get install -y unzip curl
        curl -fLO https://releases.hashicorp.com/terraform/1.7.6/terraform_1.7.6_linux_amd64.zip
        unzip terraform_1.7.6_linux_amd64.zip
        sudo mv terraform /usr/local/bin/
        terraform -v

        echo "Creating folder for VM setup code..."
        sudo mkdir -p /root/vm-setup

        echo "Copying Terraform VM setup code..."
        sudo cp -r $(Pipeline.Workspace)/s/vm-setup-azure-devops-tools/vm-setup/* /root/vm-setup/

        cd /root/vm-setup
        terraform init
        terraform validate
        terraform plan -out=tfplan
        terraform apply -auto-approve tfplan
      displayName: 'Terraform Apply for VM Setup'

# -------------------------------
# Stage 2 – Wait until new agent is ready
# -------------------------------
- stage: Wait_for_New_Agent
  displayName: 'Wait for vipin-agent registration'
  dependsOn: VM_Creation_using_existing_Self_Hosted_Agent
  jobs:
  - job: wait_for_agent_registration
    displayName: 'Check periodically until vipin-agent is online'
    pool:
      name: 'vadapav'
    steps:
    - script: |
        sudo apt-get update && sudo apt-get install -y jq

        echo "Waiting for self-hosted agent '$(agent_name)' to register..."
        for i in {1..20}; do
          echo "Attempt $i: Checking agent status..."

          online=$(curl -s -u ":$(ado_pat)" \
            "$(org_url)/_apis/distributedtask/pools?poolName=$(agent_pool)&api-version=7.0" \
            | jq -r ".value[0].agents[] | select(.name==\"$(agent_name)\") | .status")

          if [[ "$online" == "online" ]]; then
            echo "✅ $(agent_name) is online and ready!"
            exit 0
          fi

          echo "⏳ Agent not online yet. Waiting 30s..."
          sleep 30
        done

        echo "❌ $(agent_name) did not come online in expected time!"
        exit 1
      displayName: 'Wait for agent to be online'

# -------------------------------
# Stage 3 – Install Tools on New VM
# -------------------------------
- stage: Install_tools_on_hosted_vm
  displayName: 'Install DevOps Tools on Newly Created Self-Hosted VM'
  dependsOn: Wait_for_New_Agent
  jobs:
  - job: install_tools_on_hosted_vm
    displayName: 'Install DevOps Tools via Terraform'
    pool:
      name: 'vadapav'
      demands:
        - agent.name -equals $(agent_name)
    steps:
    - checkout: self
      path: vm-setup-azure-devops-tools

    - script: |
        sudo mkdir -p /root/vm-tools
        sudo cp -r $(Pipeline.Workspace)/s/vm-setup-azure-devops-tools/vm-tools/* /root/vm-tools/
        cd /root/vm-tools

        echo "Initializing and applying Terraform for tool setup..."
        terraform init
        terraform validate
        terraform plan -out=tfplan
        terraform apply -auto-approve tfplan
      displayName: 'Terraform Apply for DevOps Tools'
