trigger: none

variables:
  org_url: "https://dev.azure.com/vadapavsamosa/user19"
  existing_agent: "vipin-agent-machine"

pool:
  name: 'vadapav'

stages:

# --------------------------------------------------------------------
# Stage 1 — Create Ubuntu VM via Terraform
# --------------------------------------------------------------------
- stage: VM_Creation
  displayName: 'Stage 1: Create Ubuntu VM via Terraform'
  jobs:
  - job: create_vm
    displayName: 'Terraform Apply for VM'
    pool:
      name: 'vadapav'
      demands:
        - agent.name -equals $(existing_agent)
    steps:
    - checkout: self
      path: vm-setup-azure-devops-tools

    - script: |
        echo "=== Installing prerequisites (unzip, curl, git, jq) ==="
        sudo yum install -y unzip curl git jq

        echo "=== Installing Terraform 1.7.5 ==="
        curl -fL -o terraform_1.7.5_linux_amd64.zip https://releases.hashicorp.com/terraform/1.7.5/terraform_1.7.5_linux_amd64.zip
        unzip terraform_1.7.5_linux_amd64.zip
        sudo mv terraform /usr/local/bin/
        sudo chmod +x /usr/local/bin/terraform
        rm terraform_1.7.5_linux_amd64.zip
        terraform -v

        echo "=== Running Terraform to create VM ==="
        cd $(Pipeline.Workspace)/vm-setup-azure-devops-tools/vm-setup
        terraform init
        terraform apply -auto-approve

        # Capture VM public IP (first element of list)
        VM_IP=$(terraform output -json public_ip_addresses | jq -r '.[0]')
        echo "✅ VM Public IP: $VM_IP"

        if [ -z "$VM_IP" ]; then
          echo "❌ ERROR: VM IP is empty. Exiting..."
          exit 1
        fi

        # Export VM IP to next stage
        echo "##vso[task.setvariable variable=vm_public_ip;isOutput=true]$VM_IP"
      name: set_vm_ip
      displayName: 'Terraform Apply for VM'

# --------------------------------------------------------------------
# Stage 2 — Install DevOps Tools on the new VM
# --------------------------------------------------------------------
- stage: Install_Tools
  displayName: 'Stage 2: Install DevOps Tools on new VM'
  dependsOn: VM_Creation
  variables:
    vm_public_ip: $[ stageDependencies.VM_Creation.create_vm.outputs['set_vm_ip.vm_public_ip'] ]

  jobs:
  - job: install_tools
    displayName: 'Install DevOps Tools via Terraform'
    pool:
      name: 'vadapav'

    steps:
    - checkout: self
      path: vm-setup-azure-devops-tools

    # Debug — verify VM IP is passed
    - script: |
        echo "=============================="
        echo "VM IP received from Stage 1: $(vm_public_ip)"
        echo "=============================="
      displayName: 'Debug — Verify VM IP'

    # Run Terraform on Stage 2 folder for tools installation
    - script: |
        echo "=== Running Terraform for DevOps Tools installation ==="
        cd $(Pipeline.Workspace)/vm-setup-azure-devops-tools/vm-tools

        terraform -v || {
          echo "Terraform not found — installing..."
          curl -fL -o terraform_1.7.5_linux_amd64.zip https://releases.hashicorp.com/terraform/1.7.5/terraform_1.7.5_linux_amd64.zip
          unzip terraform_1.7.5_linux_amd64.zip
          sudo mv terraform /usr/local/bin/
          sudo chmod +x /usr/local/bin/terraform
          rm terraform_1.7.5_linux_amd64.zip
        }

        terraform init
        terraform validate
        terraform plan -var "vm_public_ip=$(vm_public_ip)" -out=tfplan
        terraform apply -auto-approve tfplan
      displayName: 'Terraform Apply for DevOps Tools'

- stage: Create_AKS
  displayName: 'Stage 3: Create AKS via Terraform + Ansible'
  dependsOn: Install_Tools
  variables:
    vm_public_ip: $[ stageDependencies.VM_Creation.create_vm.outputs['set_vm_ip.vm_public_ip'] ]
  jobs:
  - job: create_aks
    pool:
      name: 'vadapav'
    steps:
    - checkout: self
    - script: |
        echo "=== Running Terraform to trigger Ansible installation ==="
        cd $(Pipeline.Workspace)/vm-setup-azure-devops-tools/vm-ansible
        terraform init
        terraform apply -auto-approve -var "vm_public_ip=$(vm_public_ip)"
      displayName: 'Run Terraform + Ansible for AKS'
